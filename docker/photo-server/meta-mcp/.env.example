# Postgres (existing instance on the `private` network)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=metamcp
POSTGRES_PASSWORD=
POSTGRES_DB=metamcp

# Auth: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Authentik OIDC (client id is set in compose.yml)
OIDC_CLIENT_SECRET=

# Don't create the upstream default user/keys/public no-auth endpoint
BOOTSTRAP_ENABLE=false

# Optional
LOG_LEVEL=errors-only

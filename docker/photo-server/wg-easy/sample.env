# Only read on the very first start (empty ./data). Remove after setup if you like.
INIT_USERNAME=''
INIT_PASSWORD=''

# Authentik OIDC values are available from the authentik Terraform outputs.
OAUTH_PROVIDERS=oidc
OAUTH_OIDC_SERVER=https://idp.jstockley.com
OAUTH_OIDC_CLIENT_ID='<authentik_wg_easy_client_id>'
OAUTH_OIDC_CLIENT_SECRET='<authentik_wg_easy_client_secret>'
OAUTH_OIDC_NAME=Authentik

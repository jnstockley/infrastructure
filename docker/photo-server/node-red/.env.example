# --- Nextcloud Talk Bot API settings ---
# Base URL of your Nextcloud instance, no trailing slash, e.g. https://cloud.example.com
NC_URL=
# The conversation/room token the bot posts into (from the Talk room URL)
NC_TOKEN=
# --- Incoming webhook auth (optional but recommended) ---
# Databasus sends HTTP Basic Auth on its webhook requests. Set these to
# whatever username/password you configure in the Databasus webhook
# notifier settings, and the relay will reject anything that doesn't
# match. Leave both blank to skip verification.
NC_BOT_SECRET=
DATABASUS_WEBHOOK_USER=
DATABASUS_WEBHOOK_PASS=
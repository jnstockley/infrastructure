# Existing PostgreSQL server on the private network.
# Provision a dedicated mcphub database and owner; do not reuse MetaMCP tables.
# pgvector is optional and only needed for Smart Routing.
DB_URL=postgresql://user:pass@host:port/db

# Authentik provider client secret (client ID is set in compose.yml).
OIDC_CLIENT_SECRET=

# Generate each independently with: openssl rand -hex 32
BETTER_AUTH_SECRET=
JWT_SECRET=
ADMIN_PASSWORD=

# Generate with: openssl rand -base64 32
# Preserve this key with database backups to recover encrypted credentials.
MCPHUB_CREDENTIAL_ENCRYPTION_KEY=

# OIDC creates non-admin users. Use the bootstrap admin to grant admin access
# to the local user matching the OIDC session email when required.

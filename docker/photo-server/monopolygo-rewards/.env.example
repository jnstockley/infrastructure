# Exact API DisplayName and visible username. Change for your account.
EXPECTED_USERNAME=WonderfulFinch83
CHECK_INTERVAL=auto
FALLBACK_INTERVAL=15m
RESET_BUFFER=90s
ERROR_RETRY_INTERVAL=5m
ERROR_RETRY_MAX_INTERVAL=1h
AUTH_RETRY_INTERVAL=1h
WHEEL_ENABLED=true
GIFT_ENABLED=true
HEADLESS=true
ACTION_TIMEOUT=15s
NAVIGATION_TIMEOUT=45s
READINESS_TIMEOUT=45s
RUN_TIMEOUT=5m
SHUTDOWN_TIMEOUT=20s
DATA_DIR=./data
SESSION_FILE=session.cookies
ARTIFACT_DIR=./artifacts
ARTIFACTS_ENABLED=true
ARTIFACT_RETENTION_DAYS=7
LOG_LEVEL=INFO
# IANA timezone for displayed times, e.g. America/Chicago. State stays UTC.
TZ=UTC
# Optional rotating file logs. In Docker use /app/logs.
LOG_DIR=
# Compose only: keep stop grace longer than SHUTDOWN_TIMEOUT.
CONTAINER_STOP_GRACE_PERIOD=30s
HOST_DATA_DIR=./data
HOST_ARTIFACT_DIR=./artifacts
HOST_LOG_DIR=./logs

# Optional notifications: leave URL empty to disable; use error or all.
APPRISE_URL=
APPRISE_NOTIFY_ON=error
# Send once when the scheduled worker starts, including in error-only mode.
APPRISE_NOTIFY_STARTUP=true
APPRISE_TIMEOUT=10s

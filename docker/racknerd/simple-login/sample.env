# Copy this file to .env and fill in every CHANGE_ME value before starting the stack.
# Full list of upstream options: https://github.com/simple-login/app/blob/master/example.env

# ── Core webapp / worker settings (webapp, email-handler, job-runner, migrate, init) ──

# Public URL of the web UI (must match the Traefik Host() rule in compose.yml)
URL=https://app.mail.jstockley.com

# Domain used to create aliases. Must match your MX/SPF/DKIM/DMARC records (see setup.md)
EMAIL_DOMAIN=mail.jstockley.com

# Transactional email sender
SUPPORT_EMAIL=support@mail.jstockley.com
SUPPORT_NAME=Support

# Self-hosted instances should disable the mandatory ".{random_word}" alias suffix
DISABLE_ALIAS_SUFFIX=1

# MX servers for your EMAIL_DOMAIN, must match the DNS MX record priority/host
EMAIL_SERVERS_WITH_PRIORITY=[(10, "app.mail.jstockley.com.")]

# Path DKIM key is mounted at inside the containers (see compose.yml volumes) -- do not change
DKIM_PRIVATE_KEY_PATH=/dkim.key

# GPG keyring for PGP-encrypting quarantined emails -- do not change (matches compose.yml mount)
GNUPGHOME=/sl/pgp

# Store user-uploaded files (avatars, etc.) on local disk instead of S3
LOCAL_FILE_UPLOAD=true

# Where the app/email-handler/job-runner send outbound mail through -- must be the
# postfix container name so it resolves on the `private` network
POSTFIX_SERVER=postfix

# A long, random string. Generate with: openssl rand -hex 32
FLASK_SECRET=CHANGE_ME_RUN_OPENSSL_RAND_HEX_32

# Connection string to your EXISTING shared Postgres instance. Create the role/db first
# (see setup.md). Must reference the SAME database as the DB_* vars in the postfix
# section below.
DB_URI=postgresql://simplelogin:CHANGE_ME_DB_PASSWORD@postgres:5432/simplelogin

# Used only by the `migrate` container's wait-for-postgres loop -- keep in sync with DB_URI
DB_HOST=postgres
DB_PORT=5432

# Silence self-registration once you've created your account(s) -- see setup.md
# DISABLE_REGISTRATION=1
DISABLE_ONBOARDING=true

# DNS resolvers used by the app for custom-domain / MX validation
NAMESERVERS="1.1.1.1,1.0.0.1"

# Domains allowed in ?next= redirect parameters (leave empty unless you know you need this)
ALLOWED_REDIRECT_DOMAINS=[]

# Random string used to sign partner API tokens. Generate with: openssl rand -hex 32
PARTNER_API_TOKEN_SECRET=CHANGE_ME_RUN_OPENSSL_RAND_HEX_32

# ── Optional integrations (all disabled by default; uncomment to enable) ──────

# Error tracking
# SENTRY_DSN=

# Bot-protection on the signup form (recommended if DISABLE_REGISTRATION is not set)
# HCAPTCHA_SECRET=
# HCAPTCHA_SITEKEY=

# Have I Been Pwned breach scanning
# HIBP_API_KEYS=[]
# HIBP_SCAN_INTERVAL_DAYS=7

# Self-hosted usage analytics
# PLAUSIBLE_HOST=https://plausible.io
# PLAUSIBLE_DOMAIN=

# Social login providers (each needs its own OAuth app registered with the provider)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OIDC_WELL_KNOWN_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# ── Postfix (simplelogin/postfix image) ────────────────────────────────────
# https://github.com/simple-login/simplelogin-postfix-docker

# Default alias domain -- should match EMAIL_DOMAIN above
ALIASES_DEFAULT_DOMAIN=mail.jstockley.com

# Same Postgres database as DB_URI above, but as discrete fields (this image doesn't
# take a connection string). Values MUST match DB_URI or mail delivery will silently break.
DB_HOST=postgres
DB_USER=simplelogin
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=simplelogin

# Container name of the email-handler service -- do not change
EMAIL_HANDLER_HOST=email-handler

# Fully-qualified MX hostname, matches your DNS MX record and the SAN Traefik issued
# a cert for (this is also what the postfix-certs sidecar looks for under ./data/certs/)
POSTFIX_FQDN=app.mail.jstockley.com

# Certificate dumped by the postfix-certs sidecar from Traefik's ACME storage.
# Filenames come from traefik-certs-dumper's --domain-subdir output; update the
# subdirectory below if POSTFIX_FQDN differs from app.mail.jstockley.com.
TLS_CERT_FILE=/certs/app.mail.jstockley.com/certificate.crt
TLS_KEY_FILE=/certs/app.mail.jstockley.com/privatekey.key

# Networks allowed to relay through this Postfix instance without restriction.
# ADJUST to the real subnets: run `docker network inspect proxy private` and use the
# reported Subnet values. Getting this wrong either breaks outbound mail (too narrow)
# or creates an open relay (too broad) -- do not leave this unverified.
MYNETWORKS="127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128 172.16.0.0/12"

# Only needed if your host's outbound IP is blacklisted and you must relay through
# your ISP or a provider like SES/Mailgun instead of sending directly
# RELAY_HOST=
# RELAY_PORT=587
# RELAY_HOST_USERNAME=
# RELAY_HOST_PASSWORD=

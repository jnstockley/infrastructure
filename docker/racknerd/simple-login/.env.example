# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values before running anything.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Docker image version ---
# Check https://hub.docker.com/r/simplelogin/app/tags for the current
# latest stable tag and update this.
SL_VERSION=4.6.0

# --- Postgres credentials (used by both the db container and Postfix's
#     pgsql lookup config on the host) ---
POSTGRES_USER=simplelogin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ===========================================================================
# Everything below this line is consumed by the SimpleLogin app itself
# (mounted into containers as /code/.env). Full reference:
# https://github.com/simple-login/app/blob/master/example.env
# ===========================================================================

# Public URL of the web app (Traefik terminates TLS in front of this)
URL=https://mail.jstockley.com

# Domain used to create aliases - aliases will look like xyz123@mail.jstockley.com
EMAIL_DOMAIN=mail.jstockley.com

# Address SimpleLogin's own transactional emails (welcome, reset password) come from
SUPPORT_EMAIL=support@mail.jstockley.com

# MX target that custom domains (if you add any later) must point to
EMAIL_SERVERS_WITH_PRIORITY=[(10, "mail.jstockley.com.")]

# Self-hosted: disable the forced ".random_word" suffix on aliases
DISABLE_ALIAS_SUFFIX=1

# DKIM private key path (mounted read-only from ./dkim.key)
DKIM_PRIVATE_KEY_PATH=/dkim.key

# Database connection - note host "db" matches the compose service name
DB_URI=postgresql://simplelogin:CHANGE_ME_TO_A_LONG_RANDOM_STRING@db:5432/simplelogin

# Flask session secret - generate with: openssl rand -hex 32
FLASK_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

GNUPGHOME=/sl/pgp
LOCAL_FILE_UPLOAD=1

# Gateway IP of the sl-network docker network - lets containers relay
# outbound mail through the host's native Postfix
POSTFIX_SERVER=10.0.0.1

# --- Once you're happy with the instance and have created your account(s),
#     uncomment these to stop accepting new signups ---
# DISABLE_REGISTRATION=1
# DISABLE_ONBOARDING=true

# --- Optional: outbound relay (needed for reliable send/reply-from-alias -
#     most VPS providers block or heavily throttle direct outbound port 25).
#     Uncomment and fill in if/when you set one up (e.g. Brevo free tier).
# EMAIL_HANDLER_USE_SPAMASSASSIN=false

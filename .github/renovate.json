{
  "extends": [
    "config:recommended"
  ],
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "beta"
  ],
  "assignees": [
    "jnstockley"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "extends": ["schedule:weekly"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.opentofu-version$/"
      ],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "matchDepNames": ["nixpkgs"],
      "groupName": "nixpkgs",
      "commitMessageTopic": "nixpkgs"
    },
    {
      "matchManagers": ["nix"],
      "matchDepNames": ["nix-darwin"],
      "groupName": "nix-darwin",
      "commitMessageTopic": "nix-darwin"
    },
    {
      "matchManagers": ["nix"],
      "matchDepNames": ["treefmt-nix"],
      "groupName": "treefmt-nix",
      "commitMessageTopic": "treefmt-nix"
    }
  ]
}
